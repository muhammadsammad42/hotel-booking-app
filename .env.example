# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (Neon). DATABASE_URL is the direct connection, used by the
# Prisma CLI for migrations. DATABASE_URL_POOLED is the pooled connection
# (host contains "-pooler"), used by the app at runtime; if it is left out
# the app falls back to DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Demo data (npm run db:seed). The admin account is created with these
# credentials. SEED_GUEST_PASSWORD is optional: when set, every demo guest
# can sign in with it (at least 8 characters).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-me-min-8-chars"
SEED_GUEST_PASSWORD=""

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-me"

# Stripe (test mode). The secret key creates Checkout Sessions. The webhook
# secret comes from the Dashboard endpoint, or locally from:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The publishable key is not needed by hosted Checkout today; it is kept for
# Stripe.js on the client later.
STRIPE_SECRET_KEY="sk_test_replace-me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace-me"
STRIPE_WEBHOOK_SECRET="whsec_replace-me"

# Optional. The public URL of the site, for Stripe redirect links and calendar
# files. Without it the URL comes from the request (fine locally).
APP_URL=""

# Optional locally, required in production: protects /api/cron/expire-holds,
# which releases lapsed booking holds. Call it with
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Optional: booking emails through Resend (https://resend.com). Without
# RESEND_API_KEY no email is sent and the app does not mention email.
# EMAIL_FROM must be an address on a domain verified in Resend; the default
# onboarding@resend.dev only delivers to your own Resend account address.
RESEND_API_KEY=""
EMAIL_FROM="Sarai <bookings@your-domain.com>"
